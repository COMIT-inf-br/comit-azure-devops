{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "comit-azure-devops/profile.schema.json",
  "title": "Perfil de organização do Azure DevOps",
  "description": "Estrutura da org: processos, tipos, obrigatórios, estados e picklists. Sem pessoas, segredos nem tenant. O validador do plugin (server/adoplug/profile_validate.py) aplica este esquema e as regras de conteúdo proibido.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "org", "host", "auth", "usage", "measured_at", "source", "projects_policy", "projects", "processes", "link_types", "api"],
  "properties": {
    "schema_version": {"const": 1},
    "org": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "host": {"type": "string", "pattern": "^https://dev\\.azure\\.com/[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preferred", "tenant"],
      "properties": {
        "preferred": {"enum": ["az", "pat"]},
        "tenant": {"const": "discover"}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_items"],
      "properties": {
        "work_items": {"type": "boolean"},
        "hint": {"type": "string", "maxLength": 300}
      }
    },
    "measured_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "source": {"enum": ["embedded", "discovered"]},
    "projects_policy": {"enum": ["listed_only", "discover_others"]},
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "process"],
        "properties": {
          "id": {"$ref": "#/$defs/guid"},
          "name": {"type": "string", "minLength": 1, "maxLength": 128},
          "process": {"$ref": "#/$defs/guid"}
        }
      }
    },
    "processes": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/guid"},
      "additionalProperties": {"$ref": "#/$defs/process"}
    },
    "link_types": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9.-]*$"}},
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wit", "comments"],
      "properties": {
        "wit": {"type": "string", "pattern": "^\\d+\\.\\d+(-preview(\\.\\d+)?)?$"},
        "comments": {"type": "string", "pattern": "^\\d+\\.\\d+(-preview(\\.\\d+)?)?$"}
      }
    }
  },
  "$defs": {
    "guid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "field_ref": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_-]+)+$"},
    "field_list": {"type": "array", "items": {"$ref": "#/$defs/field_ref"}},
    "scalar": {"type": ["string", "integer", "number", "boolean"]},
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "parent", "work_item_types"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "parent": {"type": "string", "minLength": 1, "maxLength": 128},
        "work_item_types": {
          "oneOf": [
            {"const": "discover"},
            {"type": "object", "additionalProperties": {"$ref": "#/$defs/work_item_type"}}
          ]
        }
      }
    },
    "work_item_type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_name", "states", "required_on_create", "required_by_rule", "defaults", "picklists", "fields"],
      "properties": {
        "reference_name": {"$ref": "#/$defs/field_ref"},
        "category": {"type": "string", "pattern": "^Microsoft\\.[A-Za-z]+Category$"},
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "category"],
            "properties": {
              "name": {"type": "string", "minLength": 1, "maxLength": 128},
              "category": {"enum": ["Proposed", "InProgress", "Resolved", "Completed", "Removed"]}
            }
          }
        },
        "required_on_create": {"$ref": "#/$defs/field_list"},
        "required_by_rule": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fields", "conditions", "when", "source"],
            "properties": {
              "fields": {"$ref": "#/$defs/field_list", "minItems": 1},
              "conditions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["type"],
                      "properties": {"type": {"const": "create"}}
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["type", "field", "value"],
                      "properties": {
                        "type": {"enum": ["when", "whenNot"]},
                        "field": {"$ref": "#/$defs/field_ref"},
                        "value": {"type": "string", "maxLength": 256}
                      }
                    }
                  ]
                }
              },
              "when": {"type": "string", "maxLength": 512},
              "source": {"type": "string", "pattern": "^rule:.{1,128}$"}
            }
          }
        },
        "defaults": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/field_ref"},
          "additionalProperties": {"$ref": "#/$defs/scalar"}
        },
        "picklists": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/field_ref"},
          "additionalProperties": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scalar"}}
        },
        "suggested_fields": {"$ref": "#/$defs/field_list"},
        "fields": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/field_ref"},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type"],
            "properties": {
              "name": {"type": "string", "minLength": 1, "maxLength": 128},
              "type": {"type": "string", "pattern": "^[A-Za-z]+$"},
              "identity": {"const": true}
            }
          }
        },
        "blocking": {"$ref": "#/$defs/blocking"}
      }
    },
    "blocking": {
      "description": "Padrão de impedimento do tipo nesta org: campos e política. Opcional; sem ele, a org não tem padrão de impedimento mapeado.",
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "required": ["flag"],
          "properties": {
            "flag": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field", "value_on", "value_off"],
              "properties": {
                "field": {"$ref": "#/$defs/field_ref"},
                "value_on": {"$ref": "#/$defs/scalar"},
                "value_off": {"$ref": "#/$defs/scalar"}
              }
            },
            "responsible": {"$ref": "#/$defs/field_ref"},
            "reason": {"$ref": "#/$defs/field_ref"},
            "date": {"$ref": "#/$defs/field_ref"},
            "forecast": {"$ref": "#/$defs/field_ref"}
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "responsible_default": {"enum": ["parent_assigned_to", "item_assigned_to", "ask"]},
            "date_default": {"enum": ["today", "ask"]},
            "forecast_days": {"type": "integer"},
            "kinds": {
              "type": "object",
              "propertyNames": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
              "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 64}
            },
            "comment_templates": {
              "type": "object",
              "propertyNames": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
              "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 500}
            },
            "clear_on_unblock": {
              "type": "array",
              "items": {"enum": ["responsible", "reason", "date", "forecast"]}
            },
            "suggest_on_block": {"type": "boolean"}
          }
        }
      }
    }
  }
}
